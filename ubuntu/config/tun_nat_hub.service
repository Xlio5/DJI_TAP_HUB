[Unit]
Description=TUN NAT Hub USB Bridge
After=network.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Requires=network.target

[Service]
Type=simple
User=root
Group=root

# Step 1: 加载 g_serial Gadget
ExecStartPre=-/usr/local/bin/setup_gadget.sh

# Step 2: 配置 TUN + NAT
ExecStartPre=/usr/local/bin/setup_nat.sh

# Step 3: 守护进程（内部有 30 秒设备等待逻辑）
ExecStart=/usr/local/bin/usb_tund

# 崩溃自动重启
Restart=always
RestartSec=5

# 防止无限重启循环
StartLimitBurst=5
StartLimitIntervalSec=60

# 资源限制
LimitNOFILE=65536
LimitNPROC=256

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tun_nat_hub

[Install]
WantedBy=multi-user.target
