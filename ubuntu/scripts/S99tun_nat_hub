#!/bin/sh
# S99tun_nat_hub — TUN_NAT_HUB V3s BusyBox init (A/B OTA with auto-fallback)
# DTB dr_mode=peripheral (device-only) — g_serial auto-bind, no mode switch
set -e

_ts() { echo "[$(date +%H:%M:%S)] $*"; }

case "$1" in
  start)
    _ts "Starting TUN_NAT_HUB v1.4.3..."

    mount -t tmpfs tmpfs /var/log 2>/dev/null || true

    # 0.5 A/B OTA auto-fallback check
    # SPI: 0xFC000=slot(4B) 0xFC004=confirmed(1B) 0xFC005=retry(1B)
    CFM=$(dd if=/dev/mtdblock0 bs=1 count=1 skip=1032196 2>/dev/null | hexdump -e '1/1 "%d"')
    RTY=$(dd if=/dev/mtdblock0 bs=1 count=1 skip=1032197 2>/dev/null | hexdump -e '1/1 "%d"')
    _ts "confirmed=$CFM retry=$RTY"

    if [ "$RTY" -gt 0 ] 2>/dev/null; then
        if [ "$CFM" != "255" ] 2>/dev/null; then
            NEW_RTY=$((RTY - 1))
            if [ "$NEW_RTY" -le 0 ]; then
                _ts "FALLBACK: retries exhausted, reverting to slot A"
                printf '\377\377\377\377' | dd of=/dev/mtdblock0 bs=4 count=1 seek=257998 2>/dev/null
                printf '\377' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032196 2>/dev/null
                sync
                reboot
            fi
            _ts "Upgrade trial: retry=$NEW_RTY/$RTY"
        fi
    fi

    /usr/local/bin/usb_tund > /var/log/usb_tund.log 2>&1 &
    _ts "usb_tund: started"

    # Start web_server BEFORE network setup (doesn't need eth0)
    /usr/local/bin/web_server > /var/log/web_server.log 2>&1 &
    _ts "web_server: started"

    /usr/local/bin/setup_v3s.sh

    [ -c /dev/ttyGS0 ] && chmod 666 /dev/ttyGS0

    # Mark boot confirmed stable
    if [ "$CFM" != "255" ] 2>/dev/null || [ "$RTY" -gt 0 ] 2>/dev/null; then
        printf '\377' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032196 2>/dev/null
        printf '\000' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032197 2>/dev/null
        sync
        _ts "Boot confirmed stable"
    fi

    _ts "TUN_NAT_HUB ready"
    ;;
  stop)
    _ts "Stopping TUN_NAT_HUB..."
    killall usb_tund web_server 2>/dev/null || true
    ;;
  restart)
    $0 stop; sleep 1; $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    ;;
esac
