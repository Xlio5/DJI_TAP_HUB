#!/bin/sh
# S99tun_nat_hub — TUN_NAT_HUB V3s BusyBox init (A/B OTA with auto-fallback)
# DTB dr_mode=peripheral (device-only) — g_serial auto-bind, no mode switch
set -e

_ts() { echo "[$(date +%H:%M:%S)] $*"; }

_run_bounded_log() {
    LOG="$1"; shift
    MAX="${LOG_MAX_BYTES:-65536}"
    (
        "$@" 2>&1 | while IFS= read -r LINE; do
            if [ -f "$LOG" ]; then
                SZ=$(wc -c < "$LOG" 2>/dev/null || echo 0)
                if [ "$SZ" -gt "$MAX" ] 2>/dev/null; then
                    mv "$LOG" "$LOG.1" 2>/dev/null || : > "$LOG"
                fi
            fi
            printf '%s\n' "$LINE" >> "$LOG" 2>/dev/null || true
        done
    ) &
}

_sc16_i2c_ready() {
    [ -d /sys/bus/i2c/devices/0-004d ] && [ -c /dev/ttySC0 ]
}

_start_uart0_getty() {
    if ! ps w 2>/dev/null | grep '[g]etty.*ttyS0' >/dev/null 2>&1; then
        /sbin/getty -L ttyS0 115200 vt100 &
        _ts "UART0 debug getty started on ttyS0"
    fi
}

_release_uart0_for_protocol() {
    _ts "SC16 not detected: release UART0 getty for SBUS/CRSF output"
    fuser -k /dev/ttyS0 2>/dev/null || true
    killall getty 2>/dev/null || true
    stty -F /dev/ttyS0 raw -echo 2>/dev/null || true
}

case "$1" in
  start)
    _ts "Starting TUN_NAT_HUB v1.4.4..."

    mkdir -p /tmp /var/log
    mount -t tmpfs -o size=8m tmpfs /var/log 2>/dev/null || true
    # rootfs 构建已禁用 inittab 的 ttyS0::respawn，避免 fallback 后 init 再抢 UART0。
    # S99 启动早期先保留 UART0 救援登录；网络 setup 成功后，SC16 缺失时再释放 ttyS0 给协议输出。
    _start_uart0_getty

    # 0.5 A/B OTA auto-fallback check (SPL also has NOR-based fallback for kernel panic)
    # SPI ctl block @ 0xFC000 (6 bytes):
    #   [0] flag (0xFF=A,0x00=B) [1] confirmed [2] retry [3] ver [4] last_slot [5] boot_cnt
    # skip values for bs=1: flag=1032192, confirmed=1032193, retry=1032194, last_slot=1032196
    CFM=$(dd if=/dev/mtdblock0 bs=1 count=1 skip=1032193 2>/dev/null | hexdump -e '1/1 "%d"')
    RTY=$(dd if=/dev/mtdblock0 bs=1 count=1 skip=1032194 2>/dev/null | hexdump -e '1/1 "%d"')
    LAST=$(dd if=/dev/mtdblock0 bs=1 count=1 skip=1032196 2>/dev/null | hexdump -e '1/1 "%d"')
    _ts "confirmed=$CFM retry=$RTY last_slot=$LAST"

    if [ "$RTY" -gt 0 ] 2>/dev/null; then
        if [ "$CFM" != "255" ] 2>/dev/null; then
            NEW_RTY=$((RTY - 1))
            if [ "$NEW_RTY" -le 0 ]; then
                _ts "FALLBACK: retries exhausted, reverting to last_slot=$LAST"
                # A-1 修复: 不能用 printf '%b' "\\x$LAST" — 当 LAST=255 时 \x255 被解析为
                # \x25('%')+字面'5', 写出错误字节。0xFF/0x00 用八进制固定转义写。
                if [ "$LAST" = "255" ]; then
                    printf '\377' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032192 2>/dev/null
                else
                    printf '\000' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032192 2>/dev/null
                fi
                printf '\377' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032193 2>/dev/null
                printf '\000' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032194 2>/dev/null
                sync
                reboot
            fi
            _ts "Upgrade trial: retry=$NEW_RTY/$RTY"
        fi
    fi

    /usr/local/bin/usb_tund > /var/log/usb_tund.log 2>&1 &
    _ts "usb_tund: started"

    # Start web_server BEFORE network setup (doesn't need eth0)
    /usr/local/bin/web_server > /var/log/web_server.log 2>&1 &
    _ts "web_server: started"

    SETUP_OK=0
    if /usr/local/bin/setup_v3s.sh > /var/log/setup_v3s.log 2>&1; then
        SETUP_OK=1
        _ts "setup_v3s: ok"
    else
        _ts "ERROR: setup_v3s failed; keeping UART0 rescue getty active"
    fi

    # DJI RC serial decoder:
    #   SC16 present  -> SBUS/CRSF output on AUX (/dev/ttySC0)
    #   SC16 missing  -> SBUS/CRSF fallback output on UART0 (/dev/ttyS0)
    RC_OUT_DEV="/dev/ttySC0"
    if _sc16_i2c_ready; then
        _ts "SC16 detected on i2c0 addr 0x4d; dji_rc output: $RC_OUT_DEV"
        _start_uart0_getty
    else
        RC_OUT_DEV="/dev/ttyS0"
        _release_uart0_for_protocol
        _ts "SC16 not detected; dji_rc fallback output: $RC_OUT_DEV"
    fi

    if [ "$SETUP_OK" = "1" ] && { [ -c /dev/ttyS1 ] || [ -c /dev/ttyS2 ]; }; then

        # crsf-bridge mode: protocol output CRSF frames <-> UDP 65532 (App Lua engine)
        # RC 输入由 V3s 通过网络 ADB 直接读取 Android getevent，避免依赖 App 融合与串口飞线。
        # 波特率: SPI flash 配置优先 (ELRS/MLRS 兼容, 默认 400000, DLF 精确输出)
        _run_bounded_log /tmp/dji_rc.log /usr/local/bin/dji_rc --interval 20 --out-dev "$RC_OUT_DEV" --out-baud 400000 --crsf-telem 1 --rcmsg-host 10.0.0.2 --rcmsg-port 65530 --crsf-bridge --crsfbr-host 10.0.0.2 --crsfbr-port 65532 --adb-rc --adb-rc-primary --no-app-rc --adb-host 10.0.0.2 --adb-port 5555 --adb-device /dev/input/event4
        ln -sf /tmp/dji_rc.log /var/log/dji_rc.log 2>/dev/null || true
        _ts "dji_rc: started (V3s network ADB primary, crsf-bridge, out=$RC_OUT_DEV)"
    fi

    [ -c /dev/ttyGS0 ] && chmod 666 /dev/ttyGS0

    # Mark boot confirmed stable (ctl[1]=0xFF, ctl[2]=0x00)
    if [ "$SETUP_OK" = "1" ] && { [ "$CFM" != "255" ] 2>/dev/null || [ "$RTY" -gt 0 ] 2>/dev/null; }; then
        printf '\377' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032193 2>/dev/null
        printf '\000' | dd of=/dev/mtdblock0 bs=1 count=1 seek=1032194 2>/dev/null
        sync
        _ts "Boot confirmed stable"
    elif [ "$SETUP_OK" != "1" ]; then
        _ts "Boot not confirmed: setup_v3s failed"
    fi

    _ts "TUN_NAT_HUB ready"
    ;;
  stop)
    _ts "Stopping TUN_NAT_HUB..."
    killall usb_tund web_server dji_rc 2>/dev/null || true
    ;;
  restart)
    $0 stop; sleep 1; $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    ;;
esac
