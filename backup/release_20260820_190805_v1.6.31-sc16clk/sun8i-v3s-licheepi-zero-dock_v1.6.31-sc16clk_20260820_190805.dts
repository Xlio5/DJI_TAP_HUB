#include "sun8i-v3s-licheepi-zero.dts"

#include <dt-bindings/input/input.h>

/ {
	model = "Lichee Pi Zero with Dock";
	compatible = "licheepi,licheepi-zero-dock", "licheepi,licheepi-zero",
		     "allwinner,sun8i-v3s";

	/* APB2: 15MHz keeps 921600 on integer DLL=1 and avoids V3S DLF errors. */
	assigned-clocks = <&ccu CLK_APB2>;
	assigned-clock-parents = <&ccu CLK_PLL_PERIPH0>;
	assigned-clock-rates = <15000000>;

	aliases {
		ethernet0 = &emac;
	};

	leds {
		/* The LEDs use PG0~2 pins, which conflict with MMC1 */
		status = "disabled";
	};
};

&emac {
	allwinner,leds-active-low;
	status = "okay";
};

/* TWI0/I2C0: SC16IS752IPW dual UART expander on PB6/PB7.
 * IRQ# is intentionally not connected in this hardware revision, so
 * the Linux sc16is7xx driver will use polling.
 * Address 0x4d matches the EVT board's measured I2C strap.
 */
&i2c0 {
	status = "okay";

	sc16is752_uart: serial@4d {
		compatible = "nxp,sc16is752";
		reg = <0x4d>;
		clock-frequency = <1843200>;
	};
};

&lradc {
	vref-supply = <&reg_vcc3v0>;
	status = "okay";

	button-200 {
		label = "Volume Up";
		linux,code = <KEY_VOLUMEUP>;
		channel = <0>;
		voltage = <200000>;
	};

	button-400 {
		label = "Volume Down";
		linux,code = <KEY_VOLUMEDOWN>;
		channel = <0>;
		voltage = <400000>;
	};

	button-600 {
		label = "Select";
		linux,code = <KEY_SELECT>;
		channel = <0>;
		voltage = <600000>;
	};

	button-800 {
		label = "Start";
		linux,code = <KEY_OK>;
		channel = <0>;
		voltage = <800000>;
	};
};

&mmc1 {
	broken-cd;
	bus-width = <4>;
	vmmc-supply = <&reg_vcc3v3>;
	status = "okay";
};

/* SPI NOR Flash (w25q128 @ SPI0) */
&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	cs-gpios = <0>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		label = "firmware";
		spi-max-frequency = <40000000>;
	};
};

/* UART1: DJI-B RC Plus 2 @921600 (PE21=RX, PE22=TX) */
&uart1 {
	pinctrl-0 = <&uart1_pe_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* UART2: DJI-A old RC @115200 (PB0=RX, PB1=TX/SBUS out) */
&uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};
