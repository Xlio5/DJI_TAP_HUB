<?xml version="1.0" encoding="utf-8"?>
<!-- TUN_NAT_HUB AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限（ExoPlayer RTSP 需要） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- USB Host 权限 -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- VPN 权限 -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 设备启动自启（可选） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Shizuku: 申请 API v23+ 权限 (以 shell 身份执行 getevent) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Android 11+ 包可见性: 允许查询 Shizuku 是否已安装 (决定 getevent reader 走 Shizuku 还是 adb 回退) -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TUNNATHUB">

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TUNNATHUB">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ELRS Lua 参数配置页 -->
        <activity
            android:name=".crsf.LuaParamActivity"
            android:exported="true"
            android:theme="@style/Theme.TUNNATHUB">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VPN Service -->
        <service
            android:name=".service.TunNatVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- USB 权限弹窗自动同意 (无障碍服务)。
             Shizuku 服务端不支持开机自启, 无法覆盖开机场景; 无障碍服务由系统托管,
             启用一次后重启自动生效。检测 UsbPermissionActivity 自动点"确定"。 -->
        <service
            android:name=".usb.UsbPermAccessibilityService"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usb_accessibility_config" />
        </service>

        <!-- 开机自启 + USB 热插拔 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
                <action android:name="com.tunnathub.app.USB_PERM" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </receiver>

        <receiver
            android:name=".video.RtspUdpProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tunnathub.app.RTSP_UDP_PROBE" />
            </intent-filter>
        </receiver>

        <!-- Shizuku 客户端 (App 进程启动时自动绑定 Shizuku 服务) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

    </application>

</manifest>
